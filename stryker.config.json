{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": true
  },
  "mutate": [
    "src/practice-session/components/useQuestionSource.ts",
    "src/practice-session/models/questionAttempt.ts",
    "src/practice-session/models/questionSequenceFactory.ts",
    "src/practice-session/utils/practiceFlowUtils.ts"
  ],
  "ignorePatterns": ["dependency-graph.*", "dist", "storybook-static"],
  "cleanTempDir": "always",
  "concurrency": 4,
  "reporters": ["clear-text", "progress"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 80
  }
}
