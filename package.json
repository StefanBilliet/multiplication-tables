    "react": "^19.2.6",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.13.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
